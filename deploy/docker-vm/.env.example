# Copy to .env on DOCKER-VM and replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=cypht-ai-email
CYPHT_HOST_PORT=8093

MARIADB_DATABASE=cypht
MARIADB_USER=cypht
MARIADB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_DATABASE_ROOT_PASSWORD

CYPHT_ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
CYPHT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

TZ=America/New_York
CYPHT_MODULES=core,contacts,local_contacts,gmail_contacts,feeds,jmap,imap,smtp,account,idle_timer,desktop_notifications,calendar,themes,nux,profiles,imap_folders,tags,history,saved_searches,advanced_search,highlights,inline_message,keyboard_shortcuts,brute_force
